    "DEC-D09-A": {
      "baseline": {
        "held_request_statuses": [
          200,
          200
        ],
        "probe_received": "b''",
        "request": "third TCP connection while max_connections=2 requests are held"
      },
      "go": {
        "held_request_statuses": [
          200,
          200
        ],
        "probe_received": "b'HTTP/1.1 200 OK\\r\\nCache-Control: no-store\\r\\nContent-Length: 96\\r\\nContent-Type: application/json; charset=utf-8\\r\\nDate: Sun, 06 Sep 2026 18:30:02 GMT\\r\\n\\r\\n{\"status\":\"ok\",\"service\":\"wps-enterprise-adapter\",\"version\":\"0.9.8\",\"network_calls\":\"on-demand\"}'",
        "request": "third TCP connection while max_connections=2 requests are held"
      },
      "rationale": "The D-09 accept gate itself is equivalent (proven by go/internal/httpserver TestSlotListenerClosesThirdConnection: a third connection with both slots held is closed without a response). The scenario's precondition 'two upstream arrivals' never holds because plan section B502 requires cold-miss same-key merging, which collapses the two concurrent listings into one upstream call.",
      "verdict": "plan_specified"
    },
