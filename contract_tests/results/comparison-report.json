    "DEC-D03-A": {
      "baseline": {
        "request": "4 concurrent REST uploads across 2 mounted spaces (default WPS_MAX_UPLOADS=2)",
        "statuses": [
          201,
          201,
          201,
          201
        ],
        "upstream_pre_check_arrivals": 4
      },
      "go": {
        "request": "4 concurrent REST uploads across 2 mounted spaces (default WPS_MAX_UPLOADS=2)",
        "statuses": [
          502,
          502,
          502,
          502
        ],
        "upstream_pre_check_arrivals": 4
      },
      "rationale": "D-03 ratified correction: one process-wide upload/download budget replaces the per-space slot multiplication, so 4 concurrent uploads across 2 spaces no longer pass simultaneously (the upstream barrier times out and the adapter maps the upstream 503 to 502).",
      "verdict": "approved_change"
    },
    "DEC-D04-A": {
      "baseline": {
        "case_plus_a_b": {
          "body": "{\"path\":\"/a b\",\"entry\":{\"id\":\"bench-dir-space\",\"name\":\"a b\",\"kind\":\"folder\",\"parent_id\":\"0\",\"size\":11,\"modified_at\":\"1788268272\",\"etag\":\"bench-etag-bench-dir-space\"}}",
          "status": 200
        },
        "case_weird_percent_252f": {
          "body": "{\"path\":\"/weird%252Fname.txt\",\"entry\":{\"id\":\"bench-file-weird\",\"name\":\"weird%2Fname.txt\",\"kind\":\"file\",\"parent_id\":\"0\",\"size\":11,\"modified_at\":\"1788268272\",\"etag\":\"bench-etag-bench-file-weird\"}}",
          "status": 200
        },
        "case_weird_percent_2f": {
          "body": "{\"error\":\"entry not found: weird\"}",
          "status": 404
        }
      },
      "go": {
        "case_plus_a_b": {
          "body": "{\"path\":\"/a b\",\"entry\":{\"id\":\"bench-dir-space\",\"name\":\"a b\",\"kind\":\"folder\",\"parent_id\":\"0\",\"size\":11,\"modified_at\":\"1788268272\",\"etag\":\"bench-etag-bench-dir-space\"}}",
          "status": 200
        },
        "case_weird_percent_252f": {
          "body": "{\"error\":\"entry not found: weird%252Fname.txt\"}",
          "status": 404
        },
        "case_weird_percent_2f": {
          "body": "{\"path\":\"/weird%2Fname.txt\",\"entry\":{\"id\":\"bench-file-weird\",\"name\":\"weird%2Fname.txt\",\"kind\":\"file\",\"parent_id\":\"0\",\"size\":11,\"modified_at\":\"1788268272\",\"etag\":\"bench-etag-bench-file-weird\"}}",
          "status": 200
        }
      },
      "rationale": "D-04 ratified correction: the business path is decoded exactly once, so '%252F' no longer collapses to '/' on a second decode and the literal '%2F' entry resolves.",
      "verdict": "approved_change"
    },
