[Unit]
Description=WPS Drive WebDAV adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The one-command installer replaces these values with the invoking user's
# account. Keep root only when this template is used manually.
User=root
Group=root
WorkingDirectory=/opt/wps-adapter
EnvironmentFile=-/opt/wps-adapter/config/wps-adapter.env
ExecStart=/opt/wps-adapter/runtime/wps-adapter serve
Restart=on-failure
RestartSec=5s
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The optional root-managed credential refresh helper atomically replaces
# these files after a confirmed WPS session refresh.
ReadWritePaths=/opt/wps-adapter/config /opt/wps-adapter/data /opt/wps-adapter/runtime

[Install]
WantedBy=multi-user.target
