[Unit]
Description=WPS enterprise cloud drive WebDAV adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The one-command installer replaces these values with the invoking user's
# account. Keep root only when this template is used manually.
User=root
Group=root
WorkingDirectory=/opt/wps-adapter
EnvironmentFile=-/etc/wps-adapter/wps-adapter.env
Environment=PYTHONPATH=/opt/wps-adapter/src
ExecStart=/usr/bin/python3 -m wps_adapter serve
Restart=on-failure
RestartSec=5s
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The optional root-managed credential refresh helper atomically replaces
# these files after a confirmed WPS session refresh.
ReadWritePaths=/etc/wps-adapter/secrets /var/lib/wps-adapter/uploads

[Install]
WantedBy=multi-user.target
