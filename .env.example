# WPS upstream: values below are identifiers/configuration, not secrets.
WPS_GROUP_ID=replace-with-your-own-enterprise-group-id
WPS_ROOT_ID=0
WPS_ROOT_NAME="WPS Enterprise Drive"
WPS_BASE_URL=https://365.kdocs.cn
# The WPS account host is derived as https://account.<base-domain> by default.
WPS_ACCOUNT_BASE_URL=
# Use the WPS SDK refresh-token grant automatically after an upstream 401.
WPS_AUTO_REFRESH=true
# Optional page URL observed from your own session; do not paste a URL with credentials.
WPS_REFERER=
# Optional Origin header if your own write capture shows it is required.
WPS_ORIGIN=
# Optional fallback cid only if a captured file has no link_id.
WPS_CID=

# Prefer files. Each file contains one value; the cookie file may contain the
# complete browser Cookie header (name=value; name2=value2), including rtk.
WPS_COOKIE_FILE=/etc/wps-adapter/secrets/wps-cookie
WPS_CSRF_TOKEN_FILE=/etc/wps-adapter/secrets/wps-csrf

WPS_TIMEOUT=30
WPS_LIST_COUNT=20
WPS_CACHE_TTL=2
WPS_UPLOAD_SPOOL_MEMORY=8388608
WPS_STREAM_CHUNK_SIZE=1048576
# Optional directory for request-local temporary upload spools. Leave empty
# to use the system temporary directory; files are removed after each request.
WPS_UPLOAD_SPOOL_DIR=
# Keep this much free on the spool filesystem. 0 disables the reserve.
WPS_UPLOAD_MIN_FREE_BYTES=536870912
# 0 means no adapter-side file-size ceiling.
WPS_MAX_UPLOAD_BYTES=0
# Retries apply to an interrupted signed upload and to an individual part.
WPS_UPLOAD_RETRIES=2
WPS_UPLOAD_RETRY_DELAY=0.5
# Files at or above the threshold use the observed block/multipart flow.
WPS_MULTIPART_THRESHOLD=52428800
# The upstream capture used 10 MiB parts; the server may raise this to its
# reported minimum if a future account returns a larger minimum.
WPS_MULTIPART_PART_SIZE=10485760
# The signed object-storage endpoint supports standard single-range GETs;
# set false only if a future account proves otherwise.
WPS_ENABLE_RANGE=true

# Optional local helper, invoked once after an upstream HTTP 401. It must be
# an absolute/root-owned executable that refreshes the credential files
# atomically. Empty means no automatic login is attempted.
WPS_CREDENTIAL_REFRESH_COMMAND=
WPS_CREDENTIAL_REFRESH_TIMEOUT=30

# Resource protection for the single-process adapter.
WPS_MAX_UPLOADS=2
WPS_MAX_DOWNLOADS=4
WPS_TRANSFER_WAIT_TIMEOUT=30
WPS_MAX_COPY_ENTRIES=10000
WPS_MAX_COPY_DEPTH=64
WPS_MAX_PROPFIND_ENTRIES=10000
WPS_MAX_PROPFIND_DEPTH=64

# Adapter-side Basic Auth. Use files on a VPS; never put these values in a
# shell command or a public config file.
ADAPTER_USERNAME_FILE=/etc/wps-adapter/secrets/adapter-username
ADAPTER_PASSWORD_FILE=/etc/wps-adapter/secrets/adapter-password
ADAPTER_BIND=127.0.0.1
ADAPTER_PORT=54321
ADAPTER_DAV_PREFIX=/dav
ADAPTER_REST_PREFIX=/api/v1
